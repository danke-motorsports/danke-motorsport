# Copie para .env.development na raiz e preencha os valores:
#   cp .env.development.example .env.development
#
# Usado por: docker compose up (backend + frontend)

#Backend
ASPNETCORE_ENVIRONMENT=Development
PORT=8080
ConnectionStrings__DefaultConnection=Host=aws-1-sa-east-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
Jwt__Key=<dev-jwt-secret-minimum-32-characters>
AllowedOrigins__0=http://localhost:5173

#Frontend
# Deixe vazio no Docker (o Vite faz proxy para o backend).
# Para dev manual sem Docker, pode omitir ou usar http://localhost:8080.
VITE_API_URL=
# Usado pelo Vite dentro do container frontend (docker compose).
API_PROXY_TARGET=http://backend:8080
